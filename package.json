{
  "name": "rubywhisper",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @rubywhisper/web",
    "lint": "npm run lint --workspace @rubywhisper/web",
    "typecheck": "npm run typecheck --workspace @rubywhisper/web",
    "test": "npm run test --workspace @rubywhisper/web",
    "test:auth-privacy": "npm run test:auth-privacy --workspace @rubywhisper/web",
    "test:schema-privacy": "npm run test:schema-privacy --workspace @rubywhisper/web",
    "qa:release-gate": "node scripts/qa/release-gate-preflight.mjs",
    "qa:browser-smoke": "node scripts/qa/browser-render-smoke.mjs",
    "docs:check": "node scripts/qa/docs-local-links.mjs",
    "build": "npm run build --workspace @rubywhisper/web"
  },
  "overrides": {
    "next": "16.2.6",
    "postcss": "8.5.10",
    "ws": "8.20.1"
  },
  "engines": {
    "node": ">=20"
  }
}
