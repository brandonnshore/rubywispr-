# RubyWhisper local environment template.
# Copy to .env.local or set RUBYWHISPER_ENV_FILE to a private env file outside git.
# Keep placeholder values blank. Put real values only in private env files or approved secret stores.

# Desktop transcription providers
GROQ_API_KEY=
OPENAI_API_KEY=

# Desktop defaults
RUBYWHISPER_TRANSCRIPTION_PROVIDER=
RUBYWHISPER_GROQ_MODEL=
RUBYWHISPER_OPENAI_TRANSCRIBE_MODEL=

# Local app behavior
RUBYWHISPER_LOG_LEVEL=
RUBYWHISPER_HISTORY_RETENTION_DAYS=

# Web server-only secrets and non-public runtime config
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=
DESKTOP_TOKEN_SECRET=
# Private source pattern: RUBYWHISPER_ADMIN_BOOTSTRAP_EMAILS=<verified-admin-email>[,<verified-admin-email>]
RUBYWHISPER_ADMIN_BOOTSTRAP_EMAILS=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MONTHLY_PRICE_ID=
STRIPE_ANNUAL_PRICE_ID=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
APP_DOWNLOAD_SIGNING_KEY_OR_TOKEN=
RUBYWHISPER_REALTIME_TRANSCRIPTION_ENABLED=

# Web client-safe config. Only NEXT_PUBLIC_* names may be read by client config.
NEXT_PUBLIC_RUBYWHISPER_APP_ENV=
NEXT_PUBLIC_RUBYWHISPER_APP_URL=
# Optional HTTPS URL for the public Mac beta artifact. Leave blank until release hosting is ready.
NEXT_PUBLIC_RUBYWHISPER_LATEST_APP_DOWNLOAD_URL=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Symphony / Linear orchestration
LINEAR_API_KEY=
LINEAR_PROJECT_SLUG=
SYMPHONY_SOURCE_REPO_URL=
SYMPHONY_SOURCE_REF=
SYMPHONY_WORKSPACE_ROOT=
SYMPHONY_CODEX_HOME=
SYMPHONY_CODEX_COMMAND=
SYMPHONY_CODEX_MODEL=
SYMPHONY_CODEX_REASONING=
SYMPHONY_PORT=
