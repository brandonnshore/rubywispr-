# RubyWhisper local environment template.
# Copy to .env.local or set RUBYWHISPER_ENV_FILE to a private env file outside git.

# Transcription providers
GROQ_API_KEY=
OPENAI_API_KEY=

# Defaults
RUBYWHISPER_TRANSCRIPTION_PROVIDER=groq
RUBYWHISPER_GROQ_MODEL=whisper-large-v3-turbo
RUBYWHISPER_OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# Local app behavior
RUBYWHISPER_LOG_LEVEL=info
RUBYWHISPER_HISTORY_RETENTION_DAYS=30

