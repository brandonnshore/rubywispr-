# RubyWhisper web environment template.
# Keep placeholder values blank. Put real values only in private env files or approved secret stores.

# Server-only secrets and non-public runtime config.
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
# Optional. Falls back to CLERK_SECRET_KEY in local/dev if blank.
RUBYWHISPER_DESKTOP_SESSION_SECRET=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Private source pattern: RUBYWHISPER_ADMIN_BOOTSTRAP_EMAILS=<verified-admin-email>[,<verified-admin-email>]
RUBYWHISPER_ADMIN_BOOTSTRAP_EMAILS=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MONTHLY_PRICE_ID=
STRIPE_ANNUAL_PRICE_ID=
GROQ_API_KEY=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
APP_DOWNLOAD_SIGNING_KEY_OR_TOKEN=

# Client-safe config. Only NEXT_PUBLIC_* names may be read by client config.
NEXT_PUBLIC_RUBYWHISPER_APP_ENV=
NEXT_PUBLIC_RUBYWHISPER_APP_URL=
# Optional HTTPS URL for the public Mac beta artifact. Leave blank until release hosting is ready.
NEXT_PUBLIC_RUBYWHISPER_LATEST_APP_DOWNLOAD_URL=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
